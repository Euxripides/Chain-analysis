    "/api/v1/analysis/contracts/analyze_contract": {
      "post": {
        "operationId": "analyze_contract",
        "description": "Queue detailed EVM analysis at an immutable block/hash. Default engines: WhatsABI, sevm, verified/recompiled Solidity AST (Vyper 0.4.3 for matching source), Heimdall, Slither and Gigahorse TAC. Read method_details, operating_flows, control_effects, protocols, dataflow, ir_dataflow, ir_effects, source_verification and existing sections for conditions, exact formulas, recipients, runtime immutables, configuration effects and evidence. Interface profiles do not certify economic behavior. Proxy code/storage identities stay separate. Supply bounded history and up to 20 transaction hashes for execution/prestate/diffs and ledger reconciliation. No on-chain writes or automatic full historical downloads.",
        "x-mcp-read-only": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "chain": {
                    "type": "string",
                    "enum": [
                      "bsc",
                      "ethereum",
                      "eth",
                      "polygon",
                      "arbitrum",
                      "optimism",
                      "base",
                      "avalanche",
                      "fantom",
                      "flare",
                      "gnosis",
                      "linea",
                      "scroll",
                      "somnia_mainnet",
                      "story_mainnet",
                      "taiko",
                      "telos",
                      "xlayer"
                    ]
                  },
                  "address": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$",
                    "description": "Complete EVM contract address"
                  },
                  "block": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "string",
                        "enum": [
                          "latest",
                          "safe",
                          "finalized"
                        ]
                      }
                    ]
                  },
                  "timestamp": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "from_block": {
                    "$ref": "#/properties/block/anyOf/0"
                  },
                  "to_block": {
                    "$ref": "#/properties/block/anyOf/0"
                  },
                  "tx_hashes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]{64}$"
                    },
                    "maxItems": 50
                  },
                  "include_source": {
                    "type": "boolean",
                    "default": true
                  },
                  "engines": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "whatsabi",
                        "sevm",
                        "solc-ast",
                        "heimdall",
                        "slither",
                        "gigahorse",
                        "vyper-ast"
                      ]
                    },
                    "minItems": 2,
                    "maxItems": 7,
                    "default": [
                      "whatsabi",
                      "sevm",
                      "solc-ast",
                      "heimdall",
                      "slither",
                      "gigahorse"
                    ]
                  },
                  "budget": {
                    "type": "object",
                    "properties": {
                      "max_contracts": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      },
                      "max_transactions": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      },
                      "max_state_reads": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 512
                      },
                      "max_records": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 20000
                      },
                      "max_rpc_requests": {
                        "type": "integer",
                        "minimum": 10,
                        "maximum": 2000
                      },
                      "max_credits": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000
                      },
                      "timeout_seconds": {
                        "type": "integer",
                        "minimum": 30,
                        "maximum": 1800
                      }
                    },
                    "additionalProperties": false,
                    "default": {}
                  },
                  "idempotency_key": {
                    "type": "string",
                    "maxLength": 128
                  }
                },
                "required": [
                  "chain",
                  "address"
                ],
                "additionalProperties": false,
                "$schema": "http://json-schema.org/draft-07/schema#"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durable scoped result; inspect status, metadata.completeness and per-dimension coverage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta",
                    "error"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "additionalProperties": true
                    },
                    "meta": {
                      "type": "object"
                    },
                    "error": {
                      "type": [
                        "object",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid typed request or signed cursor"
          },
          "401": {
            "description": "Missing authentication"
          },
          "403": {
            "description": "Permission or export scope refused"
          },
          "404": {
            "description": "Analysis or artifact is not in the authorized workspace"
          },
