{
  "tools": [
    {
      "name": "get_address_overview",
      "title": "Get address overview",
      "description": "Use this first when the user asks to investigate or analyze a blockchain address. Returns transaction counts, activity time range, address type, native balance availability and high-level statistics. Do not use it alone to claim current token holdings.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chain": {
            "type": "string",
            "enum": [
              "bsc",
              "ethereum",
              "tron",
              "polygon",
              "arbitrum",
              "optimism",
              "base"
            ],
            "description": "Blockchain network. Use exactly one supported lowercase value."
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "description": "Complete EVM 0x address or complete TRON Base58 address. Never abbreviate it."
          }
        },
        "required": [
          "chain",
          "address"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
