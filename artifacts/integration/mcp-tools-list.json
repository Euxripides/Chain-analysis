    {
      "name": "get_token_transfers",
      "title": "List token transfers",
      "description": "Use this for filtered, paginated ERC-20/BEP-20/TRC-20 transfer evidence. Prefer counterparties, flow summary or top flows for aggregate questions. Never page through a massive history; use export outside P0 when needed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chain": {
            "type": "string",
            "enum": [
              "bsc",
              "ethereum",
              "tron",
              "polygon",
              "arbitrum",
              "optimism",
              "base"
            ],
            "description": "Blockchain network. Use exactly one supported lowercase value."
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "description": "Complete EVM 0x address or complete TRON Base58 address. Never abbreviate it."
          },
          "direction": {
            "type": "string",
            "enum": [
              "all",
              "in",
              "out"
            ],
            "default": "all",
            "description": "Transfer direction relative to the investigated address."
          },
          "counterparty": {
            "type": "string",
            "description": "Complete counterparty address."
          },
          "start_time": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp, for example 2026-09-10T01:30:00Z."
          },
          "end_time": {
            "$ref": "#/properties/start_time"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100,
            "description": "Maximum 500. Use large export instead of requesting huge result sets."
          },
          "sort": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "default": "desc"
          },
          "token": {
            "type": "string",
            "description": "Token symbol such as USDT or USDC."
          },
          "token_contract": {
            "type": "string",
            "description": "Complete token contract address."
          },
          "min_amount": {
            "type": "string"
          },
          "max_amount": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "failed"
            ]
          }
        },
        "required": [
          "chain",
          "address"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
