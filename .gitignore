.env
*.env.local
node_modules/
dist/
frontend/node_modules/
frontend/test-results/
frontend/playwright-report/
backend/blockchain-platform-api
backend/blockchain-platform-worker
*.log
# 例外：验收证据日志是刻意保留的可核验产物（manifest.md 逐项列出 SHA-256），必须入库。
!acceptance-evidence/**/*.log
*.tsbuildinfo
__pycache__/
*.pyc
.DS_Store
tmp/
backend/bin/
mcp/node_modules/
mcp/dist/
frontend/.tmp/

# 构建产物与本地副本：不入库（2026-09-18）
#   artifacts/  单文件 53.6 MB，race 压测的 api 二进制
#   *.exe       Windows 构建产物（fixture-membership.exe，28.3 MB）
#   /home/      误建的仓库嵌套副本，路径超出 Windows MAX_PATH，会让 git 在 Windows 上报错
artifacts/
*.exe
/home/

# 部署脚本的构建产物与本地副本（2026-09-25）
#   frontend/apps/*/dist.bak-* | dist.prev-* | dist.staged-* | dist.*-previous
#     deploy-frontend-controlled.sh 的备份/暂存目录，实测累计 151 个、每轮部署都会新增；
#     它们既不是源文件也不是证据，入库只会让状态噪声淹没真实改动。
#   注意：只匹配 "dist.<后缀>"，不匹配 app 源码目录，也不动 git 已跟踪的 dist.*（若有）。
frontend/apps/*/dist.*/
# e2e 本地运行输出（含 tests-live / nginx-* / dlflow-* 等带后缀的运行目录）
frontend/test-results*/
# 人工校对时从 dist 复制出来的前端构建快照（frontend/.codex-user-dist-<日期>-<随机后缀>/）
frontend/.codex-user-dist-*/
# 未跟踪的导出探针二进制（backend/api 为历史遗留的 53.6 MB 构建产物）
backend/api
backend/exportbench
# 未跟踪的验收证据日志副本（仓库约定入库的是逐项列 SHA-256 的 manifest 证据，
# 不是逐次运行的原始日志；现存同类文件均为数 KB 级）
acceptance-evidence/dual-system-v1/sprint7/ops/prune-job-event-log-*.log
