{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@chain/ui": ["../../packages/ui/index.ts"],
      "@chain/design-tokens": ["../../packages/design-tokens/index.ts"],
      "@chain/api-client": ["../../packages/api-client/index.ts"]
    }
  },
  "include": ["src", "../../packages"]
}
