{
  "name": "blockchain-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "check:tokens": "node scripts/check-token-contrast.mjs",
    "check:uc-render": "node scripts/uc-v4-render-check.mjs",
    "check:uc-ux": "node scripts/uc-ux-repair-check.mjs",
    "check:graph": "node scripts/graph-engine-check.mjs",
    "check:bundle": "node scripts/bundle-budget-check.mjs",
    "check:contract": "node scripts/uc-contract-freeze-check.mjs",
    "check:architecture": "node scripts/uc-architecture-check.mjs",
    "check:css-shadowing": "node scripts/css-shadowing-check.mjs",
    "verify:xlsx": "node scripts/verify-xlsx-tarball.mjs",
    "build:user": "vite build --config apps/user-console/vite.config.ts",
    "build:admin": "vite build --config apps/admin-console/vite.config.ts",
    "gen:audit-coverage": "cd .. && python3 scripts/gen_audit_coverage.py"
  },
  "dependencies": {
    "@ant-design/pro-components": "2.8.10",
    "@tanstack/react-query": "^5.66.0",
    "@xyflow/react": "12.10.2",
    "ag-grid-community": "33.3.0",
    "ag-grid-react": "33.3.0",
    "antd": "5.29.3",
    "dayjs": "1.11.23",
    "echarts": "5.6.0",
    "lucide-react": "0.468.0",
    "motion": "12.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
