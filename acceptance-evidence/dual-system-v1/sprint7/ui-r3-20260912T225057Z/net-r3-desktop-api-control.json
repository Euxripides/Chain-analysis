      "responseBody": "const BASE = \"/api/v1\";\nfunction csrfCookieValue(audience) {\n  if (typeof document === \"undefined\") return \"\";\n  const match = document.cookie.match(\n    new RegExp(`(?:^|; )cs_${audience}_session_csrf=([^;]*)`)\n  );\n  return match ? decodeURIComponent(match[1]) : \"\";\n}\nfunction newIdempotencyKey() {\n  if (typeof crypto !== \"undefined\" && typeof crypto.randomUUID === \"function\") {\n    return crypto.randomUUID();\n  }\n  return `web-${Date.now()}-${Math.random().toString(16).slice(2)}-${Math.random().toString(16).slice(2)}`;\n}\nasync function http(path, init, audience = \"user\") {\n  const method = (init?.method ?? \"GET\").toUpperCase();\n  const headers = {\n    \"Content-Type\": \"application/json\",\n    ...init?.headers ?? {},\n    \"X-Auth-Audience\": audience\n  };\n  if (method !== \"GET\" && method !== \"HEAD\") {\n    const csrf = csrfCookieValue(audience);\n    if (csrf) headers[\"X-CSRF-Token\"] = csrf;\n  }\n  const res = await fetch(BASE + path, { ...init, headers, credentials: \"same-origin\" });\n  if (!res.ok) {\n    let msg = res.statusText;\n    try {\n      const body = await res.json();\n      msg = body.error?.message ?? body.error ?? msg;\n    } catch {\n    }\n    throw new Error(msg);\n  }\n  return res.json();\n}\nexport const apiControlHttp = (path, init) => http(\"/api-control\" + path, init, \"admin\");\nexport const countOracleHttp = (path) => http(\"/count-oracle\" + path, void 0, \"admin\");\nexport const api = {\n  getFlowProfile: (chain, address) => http(`/analysis/addresses/${encodeURIComponent(chain)}/${encodeURIComponent(address)}/flow-profile`),\n  getSemanticEvents: (chain, address) => http(`/analysis/addresses/${encodeURIComponent(chain)}/${encodeURIComponent(address)}/semantic-events`),\n  // admin:dataset:manage —— 必须带 admin 受众（否则后台 cookie 不会被解析）。\n  rebuildSemanticEvents: (chain, address) => http(`/analysis/addresses/${encodeURIComponent(chain)}/${encodeURIComponent(address)}/semantic-events/rebuild`, { method: \"POST\", body: \"{}\" }, \"admin\"),\n  getAdvancedAnalysis: (chain, address) => http(`/analysis/addresses/${encodeURIComponent(chain)}/${encodeURIComponent(address)}/advanced`),\n  rebuildAdvancedAnalysis: (chain, address) => http(`/analysis/addresses/${encodeURIComponent(chain)}/${encodeURIComponent(address)}/advanced/rebuild`, { method: \"POST\", body: \"{}\" }, \"admin\"),\n  listInvestigationReports: (id) => http(`/investigations/${encodeURIComponent(id)}/reports`),\n  generateInvestigationReport: (id) => http(`/investigations/${encodeURIComponent(id)}/reports`, { method: \"POST\", body: \"{}\" }),\n  listInvestigationSubjects: (id) => http(`/investigations/${encodeURIComponent(id)}/subjects`),\n  addInvestigationSubject: (id, input) => http(`/investigations/${encodeURIComponent(id)}/subjects`, { method: \"POST\", body: JSON.stringify(input) }),\n  listInvestigations: () => http(\"/investigations\"),\n  getInvestigationRuntime: (id) => http(`/investigations/${id}/runtime`),\n  getInvestigationArtifacts: (id) => http(`/investigations/${id}/artifacts`),\n  createInvestigation: (payload) => http(\"/investigations\", {\n    method: \"POST\",\n    headers: {\n      \"Content-Type\": \"application/json\",\n      \"Idempotency-Key\": newIdempotencyKey()\n    },\n    body: JSON.stringify(payload)\n  }),\n  controlInvestigation: (id, action, revision) => http(\n    `/investigations/${id}/${action}`,\n    {\n      method: \"POST\",\n      headers: {\n        \"Content-Type\": \"application/json\",\n        \"If-Match\": String(revision)\n      },\n      body: \"{}\"\n    }\n  ),\n  ensure: (payload) => http(\n    \"/datasets/ensure\",\n    { method: \"POST\", body: JSON.stringify(payload) }\n  ),\n  preview: (payload) => http(\"/datasets/coverage/preview\", {\n    method: \"POST\",\n    body: JSON.stringify(payload)\n  }),\n  listJobs: (status = \"\") => http(\n    `/download-jobs?limit=100${status ? \"&status=\" + status : \"\"}`\n  ),\n  getJob: (id) => http(`/download-jobs/${id}`),\n  pause: (id) => http(`/download-jobs/${id}/pause`, { method: \"POST\" }),\n  resume: (id) => http(`/download-jobs/${id}/resume`, { method: \"POST\" }),\n"
