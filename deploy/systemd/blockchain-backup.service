[Unit]
Description=Blockchain Platform 月度备份（PG 全量 + ClickHouse 全库 + MinIO 增量 + 配置/二进制）
After=network-online.target docker.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=/home/euripides/projects/blockchain-platform
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# 需要的密码：sudo 用于读 ClickHouse 备份目录、挂载宿主机 SMB 共享
ExecStart=/bin/bash /home/euripides/projects/blockchain-platform/scripts/s7/monthly-backup.sh
StandardOutput=append:/data/blockchain-platform/backup/timer.log
StandardError=append:/data/blockchain-platform/backup/timer.log
