# =========================
# General
# =========================
APP_ENV=development
APP_TIMEZONE=Asia/Bangkok

# =========================
# PostgreSQL
# =========================
POSTGRES_DB=blockchain_platform
POSTGRES_USER=blockchain
POSTGRES_PASSWORD=__SET_IN_DEPLOY_ENV__
POSTGRES_PORT=5433

# =========================
# ClickHouse
# =========================
CLICKHOUSE_DB=blockchain
CLICKHOUSE_USER=blockchain
CLICKHOUSE_PASSWORD=__SET_IN_DEPLOY_ENV__
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# =========================
# MinIO
# =========================
MINIO_ROOT_USER=blockchain_admin
MINIO_ROOT_PASSWORD=__SET_IN_DEPLOY_ENV__
MINIO_API_PORT=9001
MINIO_CONSOLE_PORT=9002

# =========================
# NATS
# =========================
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# =========================
# Ankr
# =========================
# 没有 API Key 时使用 ANKR_MODE=mock 跑通全链路演示
# 真实数据：ANKR_MODE=live + ANKR_API_KEY（行为见 docs/implementation-notes.md「Ankr Live 实测行为」）
ANKR_MODE=mock
ANKR_API_KEY=
ANKR_ENDPOINT=https://rpc.ankr.com/multichain
# Ankr Management MCP（官网余额、账户用量）使用 OAuth，不使用上面的 RPC Key。
# 回调必须是 HTTPS，开发环境也可用浏览器所在机器的 127.0.0.1 回环地址。
ANKR_MANAGEMENT_ENABLED=false
ANKR_MANAGEMENT_MCP_URL=https://mcp.ankr.com/mcp
ANKR_MANAGEMENT_ISSUER_URL=https://mcp.ankr.com
ANKR_MANAGEMENT_REDIRECT_URI=
ANKR_MANAGEMENT_FRONTEND_URL=http://127.0.0.1:3000/api-control?tab=providers
# 至少 32 个随机字符；用于 AES-GCM 加密 OAuth bearer，禁止提交真实值。
ANKR_MANAGEMENT_ENCRYPTION_KEY=
ANKR_MANAGEMENT_SYNC_TTL_SECONDS=300
ANKR_MAX_PAGE_SIZE=10000
ANKR_INITIAL_CONCURRENCY=32
ANKR_MAX_CONCURRENCY=48
ANKR_PROD_SAFE_CONCURRENCY=24
ANKR_PROD_FAST_CONCURRENCY=32
ANKR_PROD_TURBO_CONCURRENCY=48
ANKR_PROD_HARD_CEILING=48
ANKR_PROD_REJECT_BOUNDARY=64
ANKR_MEMORY_BUDGET_MB=6144
ANKR_ABSOLUTE_RSS_LIMIT_MB=12288
ANKR_REQUESTS_PER_MINUTE=900
ANKR_REQUEST_TIMEOUT_SECONDS=180
ANKR_RESPONSE_HEADER_TIMEOUT_SECONDS=120

# ===== V1.1 稳定性与自适应 PageSize =====
# 响应体保护：软限制(标记 HEAVY) < 硬限制(超过→ErrResponseTooLarge→降页)
ANKR_RESPONSE_SOFT_LIMIT_MB=32
ANKR_RESPONSE_HARD_LIMIT_MB=64
# 自适应阶梯（必须递增，最大<=10000）
ANKR_PAGE_LEVELS=1000,2000,5000,10000
# 各数据集初始页大小（logs 单行更大，建议 5000）
ANKR_PAGE_SIZE_TRANSACTIONS=10000
ANKR_PAGE_SIZE_TOKEN_TRANSFERS=10000
ANKR_PAGE_SIZE_NFT_TRANSFERS=10000
ANKR_PAGE_SIZE_LOGS=10000
# 升档：连续快成功页数 + 单页时长/体积上限；降档后 cooldown 成功页数
ANKR_PAGE_UP_SUCCESS_COUNT=3
ANKR_PAGE_UP_MAX_DURATION_SECONDS=30
ANKR_PAGE_UP_MAX_BODY_MB=16
ANKR_PAGE_DOWN_COOLDOWN_SUCCESS_COUNT=5
# 最小页连续失败达到该次数 → 自动拆 Range
ANKR_RANGE_SPLIT_ON_MIN_PAGE_FAILURES=3

# =========================
# V1.3 Method / ABI 解析
# =========================
# Fast Resolver（只读内存缓存，不访问外网）。关闭后交易照常入库，只是没有 Method 字段。
METHOD_RESOLVER_ENABLED=true
# 启动时写入常见协议签名种子（ERC20/721/1155/Uniswap/Pancake/Proxy/Ownable/AccessControl）
METHOD_SEED_ON_START=true
# 内存索引刷新周期（新 ABI / 新签名多久对下载链路生效）
METHOD_REGISTRY_REFRESH_SECONDS=60
# 未知 Selector 异步补全 Worker
METHOD_RESOLVER_INTERVAL_SECONDS=15
METHOD_RESOLVER_BATCH=50
# 公共 4-byte 签名库：默认关闭（内网无外网；且它只能做候选补全，不能作为唯一可信来源）
METHOD_PUBLIC_SIGNATURE_ENABLED=false
METHOD_PUBLIC_SIGNATURE_ENDPOINT=https://www.4byte.directory/api/v1/signatures/
METHOD_PUBLIC_SIGNATURE_TIMEOUT_SECONDS=10
# 历史数据 Backfill（background 优先级，批次之间让路给用户实时下载）
METHOD_BACKFILL_INTERVAL_SECONDS=10
METHOD_BACKFILL_BATCH_SIZE=20000
METHOD_BACKFILL_BATCH_IDLE_MS=200
METHOD_MAX_CACHED_ABIS=20000

# =========================
# V1.4 Token Metadata
# =========================
TOKEN_METADATA_ENABLED=true
TOKEN_METADATA_BACKFILL_ENABLED=true
TOKEN_METADATA_BACKFILL_BATCH_SIZE=500
TOKEN_METADATA_WORKER_INTERVAL_SECONDS=5
TOKEN_METADATA_BACKFILL_BATCH_IDLE_MS=200
TOKEN_METADATA_RPC_MAX_RETRIES=3
# RPC 安全阀：默认每 2 秒最多处理 1 个合约（每个合约最多 3 个 eth_call）
TOKEN_METADATA_RPC_WORKERS=1
TOKEN_METADATA_RPC_MIN_INTERVAL_MS=2000
TOKEN_LOGO_ENABLED=true
TOKEN_LOGO_MAX_BYTES=2097152
TOKEN_LOGO_MAX_WIDTH=4096
TOKEN_LOGO_MAX_HEIGHT=4096

# =========================
# V1.5 Unified Chain RPC
# =========================
RPC_ENABLED=true
RPC_DEFAULT_PROVIDER=ankr
RPC_CHAINS=bsc,eth,polygon,arbitrum,base,avalanche,optimism
# 模板与密钥分离；不要把真实密钥写入仓库或日志。
ANKR_RPC_ENABLED=true
ANKR_RPC_ENDPOINT_TEMPLATE=https://rpc.ankr.com/{chain}/{key}
ANKR_RPC_API_KEY=
RPC_HTTP_MAX_IDLE_CONNS=256
RPC_HTTP_MAX_IDLE_CONNS_PER_HOST=128
RPC_HTTP_MAX_CONNS_PER_HOST=128
RPC_GLOBAL_CONCURRENCY=64
RPC_REQUESTS_PER_SECOND=25
RPC_CHAIN_HEAD_TIMEOUT_SECONDS=5
RPC_STANDARD_TIMEOUT_SECONDS=15
RPC_LOGS_TIMEOUT_SECONDS=60
RPC_TRACE_TIMEOUT_SECONDS=60
RPC_DEBUG_TIMEOUT_SECONDS=120
RPC_RESPONSE_HARD_LIMIT_MB=64
RPC_MAX_REQUEST_BYTES=1048576
RPC_BATCH_ENABLED=true
RPC_BATCH_MAX_SIZE=100
RPC_BATCH_MAX_WAIT_MS=10
RPC_CACHE_ENABLED=true
RPC_CACHE_CAPACITY=200000
RPC_TRACE_ENABLED=true
RPC_DEBUG_ENABLED=true
RPC_WRITE_ENABLED=false
RPC_TRACE_RAW_PERSIST=true
RPC_PROBE_ON_START=true
RPC_HEALTH_SNAPSHOT_SECONDS=60
RPC_RETRY_MAX_ATTEMPTS=3
RPC_BUDGET_ENABLED=true
RPC_BUDGET_WINDOW_HOURS=24
RPC_TRACE_MAX_REQUESTS_PER_WINDOW=20000
RPC_INVESTIGATION_MAX_REQUESTS=5000
RPC_INVESTIGATION_MAX_CREDITS=200000
# 仅作为数据库 provider_pricing 无生效记录时的回退值。
RPC_CREDITS_PER_CALL=200
RPC_COST_PER_CALL_USD=0.00002

# =========================
# API
# =========================
API_HTTP_PORT=8080
API_LOG_LEVEL=info
# 应用运行账号（api/worker）。S7-SEC-01 R-07 起必须是**非超级用户**的受限登录角色，
# 连接后再由 DB_RUNTIME_ROLE 降权；不要在这里使用 owner/superuser。
#   一次性创建（owner 执行，需替换强随机口令）：
#     CREATE ROLE blockchain_api LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS NOREPLICATION;
#     GRANT blockchain_app TO blockchain_api;
DATABASE_URL=postgres://blockchain_api:__SET_IN_DEPLOY_ENV__@127.0.0.1:5433/blockchain_platform?sslmode=disable
# 迁移/初始化账号（cmd/migrate、admin-init、admin-fixture，以及 API 启动期迁移）：
# 需要 DDL 权限，因此仍是 owner。未配置时回落到 DATABASE_URL。
MIGRATION_DATABASE_URL=postgres://blockchain:__SET_IN_DEPLOY_ENV__@127.0.0.1:5433/blockchain_platform?sslmode=disable
# 运行期降权角色（0054 迁移创建）。为空时 API/Worker 使用迁移账号，仅用于本地调试。
DB_RUNTIME_ROLE=blockchain_app
CLICKHOUSE_URL=clickhouse://blockchain:__SET_IN_DEPLOY_ENV__@127.0.0.1:9000/blockchain
MINIO_ENDPOINT=127.0.0.1:9001
MINIO_SECURE=false
NATS_URL=nats://127.0.0.1:4222
RAW_BUCKET=blockchain-raw
EXPORT_BUCKET=blockchain-exports
BACKUPS_BUCKET=blockchain-backups
WORKER_METRICS_PORT=8081

# ChatGPT Actions：生产环境应通过 secret store 注入，不要提交真实密钥。
# GPT_ACTIONS_API_KEY 可作为首个 bootstrap key；后续密钥通过管理 API 创建，数据库只保存 SHA-256 摘要。
GPT_ACTIONS_API_KEY=
GPT_ACTIONS_API_KEYS=
MCP_HOST=127.0.0.1
MCP_ALLOWED_HOSTS=aurore.online,localhost,127.0.0.1
MCP_PORT=8090
MCP_API_KEY=
REST_API_BASE_URL=http://127.0.0.1:8080/api/v1
REST_API_KEY=
MCP_REQUEST_TIMEOUT_MS=60000
MCP_MAX_CONCURRENT=16
MCP_RATE_LIMIT_PER_MINUTE=60
GPT_ACTIONS_ADMIN_KEY=
GPT_ACTIONS_RATE_LIMIT_PER_MINUTE=300

# =========================
# Frontend
# =========================
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080

# =========================
# 双系统：认证与会话（§6.3 / §28.4）
# =========================
# session = 只接受服务端会话（生产必须）；hybrid = 无会话时允许兼容身份头（仅测试）；
# legacy = 完全依赖 X-User-* 头（仅用于迁移前回归对照）。production 环境即使误配也会被强制降级为 session。
AUTH_MODE=hybrid
# 经 TLS 终止（Cloudflare/Nginx）对外时设为 true，并可将 Cookie 前缀设为 __Host-
# auto（推荐）：按入口协议自适应 —— HTTPS 入口写 Secure + __Host- 前缀，HTTP 入口写普通 Cookie；
# true/false：固定行为（false 仅限本机 HTTP 调试，生产禁止）。
AUTH_COOKIE_SECURE=auto
# 仅在安全上下文（HTTPS）下生效；__Host- 要求 Secure + Path=/ + 无 Domain。
AUTH_COOKIE_PREFIX=__Host-
AUTH_COOKIE_DOMAIN=
# 空闲 12 小时，绝对 7 天
AUTH_SESSION_IDLE_TTL_SECONDS=43200
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=604800
AUTH_MAX_FAILED_LOGINS=10
AUTH_LOCK_DURATION_SECONDS=900
AUTH_LOGIN_RATE_PER_MINUTE=20
AUTH_MIN_PASSWORD_LENGTH=12
# 后台管理员强制 MFA：未实现 TOTP 前保持 false，否则登录会显式失败而不是静默放行
AUTH_REQUIRE_ADMIN_MFA=false
# 只有来自这些代理的转发头才会被采信（用于解析真实客户端 IP）
AUTH_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# 首次初始化管理员账号时使用的邮箱（密码通过 cmd/admin-init 交互输入，不写入仓库）
AUTH_BOOTSTRAP_EMAIL=

# 双系统前端端口（Nginx 反代目标）
USER_CONSOLE_PORT=3001
ADMIN_CONSOLE_PORT=3002
# =========================
# dRPC Solana 数据源（开发文档《Solana dRPC 数据源接入开发文档》）
# =========================
# 是否启用 dRPC Provider。开启后 Solana 的路由会**动态**解析：
#   - 受管密钥文件里已有可用的 runtime_api_key  → 走 dRPC（Data API + Solana JSON-RPC）；
#   - 没有任何可用密钥                          → 自动回退到既有的 Ankr Solana JSON-RPC，
#     下载不会因为"还没录入 Key"而失败，Provider 页面显示"未配置运行密钥"。
# 因此推荐常开：部署后到后台"Provider 账户 → dRPC Solana → 密钥"粘贴 Key 即可生效（无需重启）。
DRPC_ENABLED=true
# paid | free | unknown。unknown/free 时数据面按 DRPC_UNKNOWN_TIER_CU_PER_MINUTE 钳制，
# 并在 Provider 页面标注 degraded_reason=cu_cap_unknown_tier。录入 Key 并同步一次额度后改成 paid。
DRPC_TIER=unknown
# 两个 base URL 都不含 API Key；Key 由后端在请求时解析，永不写进配置文件/日志/前端。
DRPC_BASE_URL=https://lb.drpc.live/solana
DRPC_MANAGEMENT_BASE_URL=https://drpc.org
# 密钥引用。store:// 表示后台录入后写入受管文件的密钥；也可以用 env://NAME 走环境变量。
DRPC_RUNTIME_KEY_REF=store://drpc/runtime_api_key
DRPC_STATISTICS_TOKEN_REF=store://drpc/statistics_api_token
DRPC_KEYS_TOKEN_REF=store://drpc/keys_api_token
# 受管密钥文件（0600）。留空则默认 $HOME/.blockchain-platform/provider-secrets.json
PROVIDER_SECRETS_FILE=
# 下载行为
DRPC_SOLANA_HISTORY_PAGE_SIZE=100
DRPC_SOLANA_MAX_TX_VERSION=0
DRPC_SOLANA_RPC_REQUEST_TIMEOUT_SECONDS=30
DRPC_SOLANA_DATA_REQUEST_TIMEOUT_SECONDS=60
DRPC_SOLANA_SLOT_TIME_SEARCH_LIMIT=64
DRPC_SOLANA_SLOT_TIME_MARGIN_SECONDS=120
# 额度保护
DRPC_UNKNOWN_TIER_CU_PER_MINUTE=45000
DRPC_QUOTA_WARN_PERCENT=80
DRPC_QUOTA_SAFE_ONLY_PERCENT=95
DRPC_QUOTA_STOP_PERCENT=100
DRPC_BALANCE_WARN=
# 管理信息同步（官方管理接口限制 10 请求/分钟）
DRPC_MANAGEMENT_SYNC_INTERVAL_SECONDS=300
DRPC_MANAGEMENT_STALE_AFTER_SECONDS=900
DRPC_MANAGEMENT_SAFE_ONLY_AFTER_SECONDS=3600
# Solana 取数 Provider：drpc | solana-rpc。设为 drpc 但未配置 Key 时会自动回退到 solana-rpc。
SOLANA_PROVIDER=drpc

