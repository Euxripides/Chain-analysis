# =========================
# General
# =========================
APP_ENV=development
APP_TIMEZONE=Asia/Bangkok

# =========================
# PostgreSQL
# =========================
POSTGRES_DB=blockchain_platform
POSTGRES_USER=blockchain
POSTGRES_PASSWORD=change_me_pg_2026
POSTGRES_PORT=5433

# =========================
# ClickHouse
# =========================
CLICKHOUSE_DB=blockchain
CLICKHOUSE_USER=blockchain
CLICKHOUSE_PASSWORD=change_me_ch_2026
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# =========================
# MinIO
# =========================
MINIO_ROOT_USER=blockchain_admin
MINIO_ROOT_PASSWORD=change_me_minio_2026
MINIO_API_PORT=9001
MINIO_CONSOLE_PORT=9002

# =========================
# NATS
# =========================
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# =========================
# Ankr
# =========================
# 没有 API Key 时使用 ANKR_MODE=mock 跑通全链路演示
# 真实数据：ANKR_MODE=live + ANKR_API_KEY（行为见 docs/implementation-notes.md「Ankr Live 实测行为」）
ANKR_MODE=mock
ANKR_API_KEY=
ANKR_ENDPOINT=https://rpc.ankr.com/multichain
ANKR_MAX_PAGE_SIZE=10000
ANKR_INITIAL_CONCURRENCY=4
ANKR_MAX_CONCURRENCY=32
ANKR_REQUESTS_PER_MINUTE=900
ANKR_REQUEST_TIMEOUT_SECONDS=60
ANKR_RESPONSE_HEADER_TIMEOUT_SECONDS=120

# ===== V1.1 稳定性与自适应 PageSize =====
# 响应体保护：软限制(标记 HEAVY) < 硬限制(超过→ErrResponseTooLarge→降页)
ANKR_RESPONSE_SOFT_LIMIT_MB=32
ANKR_RESPONSE_HARD_LIMIT_MB=64
# 自适应阶梯（必须递增，最大<=10000）
ANKR_PAGE_LEVELS=1000,2000,5000,10000
# 各数据集初始页大小（logs 单行更大，建议 5000）
ANKR_PAGE_SIZE_TRANSACTIONS=10000
ANKR_PAGE_SIZE_TOKEN_TRANSFERS=10000
ANKR_PAGE_SIZE_NFT_TRANSFERS=10000
ANKR_PAGE_SIZE_LOGS=5000
# 升档：连续快成功页数 + 单页时长/体积上限；降档后 cooldown 成功页数
ANKR_PAGE_UP_SUCCESS_COUNT=3
ANKR_PAGE_UP_MAX_DURATION_SECONDS=30
ANKR_PAGE_UP_MAX_BODY_MB=16
ANKR_PAGE_DOWN_COOLDOWN_SUCCESS_COUNT=5
# 最小页连续失败达到该次数 → 自动拆 Range
ANKR_RANGE_SPLIT_ON_MIN_PAGE_FAILURES=3

# =========================
# V1.3 Method / ABI 解析
# =========================
# Fast Resolver（只读内存缓存，不访问外网）。关闭后交易照常入库，只是没有 Method 字段。
METHOD_RESOLVER_ENABLED=true
# 启动时写入常见协议签名种子（ERC20/721/1155/Uniswap/Pancake/Proxy/Ownable/AccessControl）
METHOD_SEED_ON_START=true
# 内存索引刷新周期（新 ABI / 新签名多久对下载链路生效）
METHOD_REGISTRY_REFRESH_SECONDS=60
# 未知 Selector 异步补全 Worker
METHOD_RESOLVER_INTERVAL_SECONDS=15
METHOD_RESOLVER_BATCH=50
# 公共 4-byte 签名库：默认关闭（内网无外网；且它只能做候选补全，不能作为唯一可信来源）
METHOD_PUBLIC_SIGNATURE_ENABLED=false
METHOD_PUBLIC_SIGNATURE_ENDPOINT=https://www.4byte.directory/api/v1/signatures/
METHOD_PUBLIC_SIGNATURE_TIMEOUT_SECONDS=10
# 历史数据 Backfill（background 优先级，批次之间让路给用户实时下载）
METHOD_BACKFILL_INTERVAL_SECONDS=10
METHOD_BACKFILL_BATCH_SIZE=20000
METHOD_BACKFILL_BATCH_IDLE_MS=200
METHOD_MAX_CACHED_ABIS=20000

# =========================
# V1.4 Token Metadata
# =========================
TOKEN_METADATA_ENABLED=true
TOKEN_METADATA_BACKFILL_ENABLED=true
TOKEN_METADATA_BACKFILL_BATCH_SIZE=500
TOKEN_METADATA_WORKER_INTERVAL_SECONDS=5
TOKEN_METADATA_BACKFILL_BATCH_IDLE_MS=200
TOKEN_METADATA_RPC_MAX_RETRIES=3
# RPC 安全阀：默认每 2 秒最多处理 1 个合约（每个合约最多 3 个 eth_call）
TOKEN_METADATA_RPC_WORKERS=1
TOKEN_METADATA_RPC_MIN_INTERVAL_MS=2000
TOKEN_LOGO_ENABLED=true
TOKEN_LOGO_MAX_BYTES=2097152
TOKEN_LOGO_MAX_WIDTH=4096
TOKEN_LOGO_MAX_HEIGHT=4096

# =========================
# V1.5 Unified Chain RPC
# =========================
RPC_ENABLED=true
RPC_DEFAULT_PROVIDER=ankr
RPC_CHAINS=bsc
# 模板与密钥分离；不要把真实密钥写入仓库或日志。
ANKR_RPC_ENABLED=true
ANKR_RPC_ENDPOINT_TEMPLATE=https://rpc.ankr.com/{chain}/{key}
ANKR_RPC_API_KEY=
RPC_HTTP_MAX_IDLE_CONNS=256
RPC_HTTP_MAX_IDLE_CONNS_PER_HOST=128
RPC_HTTP_MAX_CONNS_PER_HOST=128
RPC_GLOBAL_CONCURRENCY=64
RPC_REQUESTS_PER_SECOND=25
RPC_CHAIN_HEAD_TIMEOUT_SECONDS=5
RPC_STANDARD_TIMEOUT_SECONDS=15
RPC_LOGS_TIMEOUT_SECONDS=60
RPC_TRACE_TIMEOUT_SECONDS=60
RPC_DEBUG_TIMEOUT_SECONDS=120
RPC_RESPONSE_HARD_LIMIT_MB=64
RPC_MAX_REQUEST_BYTES=1048576
RPC_BATCH_ENABLED=true
RPC_BATCH_MAX_SIZE=100
RPC_BATCH_MAX_WAIT_MS=10
RPC_CACHE_ENABLED=true
RPC_CACHE_CAPACITY=200000
RPC_TRACE_ENABLED=true
RPC_DEBUG_ENABLED=true
RPC_WRITE_ENABLED=false
RPC_TRACE_RAW_PERSIST=true
RPC_PROBE_ON_START=true
RPC_HEALTH_SNAPSHOT_SECONDS=60
RPC_RETRY_MAX_ATTEMPTS=3
RPC_BUDGET_ENABLED=true
RPC_BUDGET_WINDOW_HOURS=24
RPC_TRACE_MAX_REQUESTS_PER_WINDOW=20000
RPC_INVESTIGATION_MAX_REQUESTS=5000
RPC_INVESTIGATION_MAX_CREDITS=200000
# 仅作为数据库 provider_pricing 无生效记录时的回退值。
RPC_CREDITS_PER_CALL=200
RPC_COST_PER_CALL_USD=0.00002

# =========================
# API
# =========================
API_HTTP_PORT=8080
API_LOG_LEVEL=info
DATABASE_URL=postgres://blockchain:change_me_pg_2026@127.0.0.1:5433/blockchain_platform?sslmode=disable
CLICKHOUSE_URL=clickhouse://blockchain:change_me_ch_2026@127.0.0.1:9000/blockchain
MINIO_ENDPOINT=127.0.0.1:9001
MINIO_SECURE=false
NATS_URL=nats://127.0.0.1:4222
RAW_BUCKET=blockchain-raw
EXPORT_BUCKET=blockchain-exports
BACKUPS_BUCKET=blockchain-backups
WORKER_METRICS_PORT=8081

# =========================
# Frontend
# =========================
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080
